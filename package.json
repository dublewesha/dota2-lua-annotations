{
    "name": "dota2-lua-annotations",
    "displayName": "Dota2 Lua Annotations",
    "description": "Dota2 lua api annotations for lua-language-server",
    "version": "1.1.5",
    "license": "MIT",
    "publisher": "robincode",
    "icon": "logo.png",
    "keywords": [
        "Lua",
        "Dota2"
    ],
    "repository": {
        "url": "https://github.com/robincodex/dota2-lua-annotations"
    },
    "categories": [
        "Linters",
        "Programming Languages"
    ],
    "extensionDependencies": [
        "sumneko.lua"
    ],
    "engines": {
        "vscode": "^1.77.0"
    },
    "activationEvents": [
        "onLanguage:lua"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "snippets": [
            {
                "language": "lua",
                "path": "./snippets/snippets.code-snippets"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "dump": "tsx dump/dump.ts"
    },
    "devDependencies": {
        "@moddota/dota-data": "^0.47.2",
        "@types/node": "^26.6.5",
        "@types/vscode": "~1.77.0",
        "@vscode/vsce": "^4.0.0",
        "axios": "^1.20.0",
        "octokit": "^5.0.5",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
